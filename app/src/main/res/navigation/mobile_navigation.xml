<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="br.com.lconeto.mercadoportega.home.presentation.HomeFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_nav_home_to_shoppingFragment"
            app:destination="@id/shoppingFragment" />
        <action
            android:id="@+id/action_nav_home_to_selectionFragment"
            app:destination="@id/selectionFragment" />
    </fragment>

    <fragment
        android:id="@+id/selectionFragment"
        android:name="br.com.lconeto.mercadoportega.selection.presentation.SelectionFragment"
        android:label="@string/selection_title"
        tools:layout="@layout/fragment_selection" />

    <fragment
        android:id="@+id/shoppingFragment"
        android:name="br.com.lconeto.mercadoportega.shopping.presentation.ShoppingFragment"
        android:label="ShoppingFragment" />
</navigation>